<?xml version="1.0" encoding="UTF-8"?>
<!--
    The table name is authoritative only at its default: TableNameListener
    applies `activity.table` from configuration. Index names are left to
    Doctrine, derived from the table name, so they follow it too (PostgreSQL
    index names are schema-wide).

    Written by ActivityWriter through DBAL, read through the ORM: the columns
    below are the contract between the two.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="AlexandreBulete\DddActivityBundle\Domain\Model\ActivityEntry" table="activity_log">
        <id name="id" type="activity_entry_id"/>
        <field name="occurredAt" type="datetime_immutable" column="occurred_at"/>
        <field name="kind" type="string" length="10" enum-type="AlexandreBulete\DddActivityBundle\Domain\ValueObject\EntryKind"/>
        <field name="action" type="string" length="255"/>
        <field name="permission" type="string" length="190" nullable="true"/>
        <field name="outcome" type="string" length="10" enum-type="AlexandreBulete\DddActivityBundle\Domain\ValueObject\Outcome"/>
        <field name="error" type="text" nullable="true"/>
        <field name="actorKind" type="string" column="actor_kind" length="10"/>
        <field name="actorId" type="string" column="actor_id" length="64" nullable="true"/>
        <field name="actorLabel" type="string" column="actor_label" length="255"/>
        <field name="channel" type="string" length="32"/>
        <field name="correlationId" type="string" column="correlation_id" length="64"/>
        <field name="causationId" type="string" column="causation_id" length="64" nullable="true"/>
        <field name="messageId" type="string" column="message_id" length="64" nullable="true"/>
        <field name="subjectType" type="string" column="subject_type" length="64" nullable="true"/>
        <field name="subjectId" type="string" column="subject_id" length="64" nullable="true"/>
        <field name="summary" type="string" length="190" nullable="true"/>
        <field name="summaryParams" type="jsonb" column="summary_params"/>
        <field name="details" type="jsonb"/>

        <indexes>
            <index columns="occurred_at"/>
            <index columns="correlation_id"/>
            <index columns="actor_kind,actor_id"/>
            <index columns="subject_type,subject_id"/>
            <index columns="action"/>
        </indexes>
    </entity>
</doctrine-mapping>
